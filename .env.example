# Copy to .env and adjust. Never commit .env.
POSTGRES_DB=knowledgehub
POSTGRES_USER=kh
POSTGRES_PASSWORD=change-me
# Backend
DB_URL=jdbc:postgresql://postgres:5432/knowledgehub
DB_USER=kh
DB_PASSWORD=change-me
LLM_BASE_URL=http://mock-llm:4000
LLM_API_KEY=
LLM_MODEL=mock-1
LLM_EMBEDDING_DIM=384
LLM_CONNECT_TIMEOUT=2s
LLM_READ_TIMEOUT=30s
LLM_EXECUTOR_CORE=4
LLM_EXECUTOR_MAX=16
LLM_EXECUTOR_QUEUE=100
# Mock LLM chaos
FAIL_RATE_429=0.1
FAIL_RATE_503=0.05
TOKEN_DELAY_MS=40
